#!/usr/bin/env bash
# Test shim: only on PATH after `with_command dkms`. `status` prints one installed nvidia module.
printf '%s\n' "$(basename "$0") $*" >> "$SHIM_LOG"
[ "$1" = "status" ] || { echo "dkms shim: unsupported call: $*" >&2; exit 1; }
echo "nvidia/620.70.06, $(cat "$SHIM_STATE/uname" 2>/dev/null || echo 6.11.11-valve12-1-neptune-611-gb3afa9aa9ae7), x86_64: installed"
