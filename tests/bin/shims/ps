#!/usr/bin/env bash
# Test shim: the Steam process belongs to "xgmtest", a user that cannot exist on a real host,
# so a path built from $PRIMARY_USER never points at a real home directory. Prints nothing (Steam
# not running, as at boot) when $SHIM_STATE/steam_not_running exists.
printf '%s\n' "$(basename "$0") $*" >> "$SHIM_LOG"
[ -e "$SHIM_STATE/steam_not_running" ] && exit 1
echo "xgmtest"
