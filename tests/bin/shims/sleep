#!/usr/bin/env bash
# Test shim: returns instantly and simulates XG Mobile hotplug. The fake eGPU follows the
# egpu_enable flag: once it reads 1 (and $SHIM_STATE/egpu_appears is nvidia|amd) card1 appears;
# once it reads 0 (unless $SHIM_STATE/egpu_drops is "no") card1 disappears.
printf '%s\n' "$(basename "$0") $*" >> "$SHIM_LOG"
ROOT="$XGM_ROOT"
enabled=$(cat "$ROOT/sys/devices/platform/asus-nb-wmi/egpu_enable" 2>/dev/null)
appears=$(cat "$SHIM_STATE/egpu_appears" 2>/dev/null)
drops=$(cat "$SHIM_STATE/egpu_drops" 2>/dev/null)
if [ "$enabled" = "1" ] && [ ! -e "$ROOT/dev/dri/card1" ]; then
  case "$appears" in
    nvidia|amd)
      touch "$ROOT/dev/dri/card1" "$ROOT/dev/dri/renderD129"
      mkdir -p "$ROOT/sys/class/drm/card1/device"
      if [ "$appears" = "nvidia" ]; then
        echo "0x10de" > "$ROOT/sys/class/drm/card1/device/vendor"
        touch "$ROOT/dev/nvidiactl" "$ROOT/dev/nvidia0"
      else
        echo "0x1002" > "$ROOT/sys/class/drm/card1/device/vendor"
      fi
      ;;
  esac
elif [ "$enabled" = "0" ] && [ -e "$ROOT/dev/dri/card1" ] && [ "$drops" != "no" ]; then
  rm -rf "$ROOT/dev/dri/card1" "$ROOT/dev/dri/renderD129" "$ROOT/sys/class/drm/card1" "$ROOT/dev/nvidiactl" "$ROOT/dev/nvidia0"
fi
exit 0
