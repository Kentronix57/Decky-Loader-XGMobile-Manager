#!/usr/bin/env bash
# Test shim: returns instantly and simulates XG Mobile hotplug. The fake eGPU follows the
# egpu_enable flag: once it reads 1 (and $SHIM_STATE/egpu_appears is nvidia|amd) its PCI device
# (0000:01:00.0, boot_vga 0) appears with the DRM and fb nodes in $SHIM_STATE/egpu_nodes (card1
# renderD129 fb1 by default; see gpu_numbering), and for nvidia /dev/nvidia* and the nvidia module
# dirs (nvidia_drm with modeset/fbdev Y and a refcnt), as udev would load them. Once it reads 0 (unless $SHIM_STATE/egpu_drops is "no") the PCI
# device and its nodes disappear. After egpu_card_later, the eGPU's DRM card appears on the tick
# it names.
printf '%s\n' "$(basename "$0") $*" >> "$SHIM_LOG"
ROOT="$XGM_ROOT"
[ -n "$ROOT" ] || exit 0
# Every call is also one tick of the user-session timelines (runtime dir and bus socket included),
# and moves the fake clock forward by its argument (plus any clock_step set for the new tick).
# shellcheck source=../helpers/timeline.bash
. "$(dirname "$(readlink -f "$0")")/../helpers/timeline.bash"
tl_advance
tl_clock_add "${1:-0}"
tl_clock_steps
tl_apply_fs "$ROOT"
# shellcheck source=../helpers/fake_gpu.bash
. "$(dirname "$(readlink -f "$0")")/../helpers/fake_gpu.bash"
PCI=$(fake_gpu_pci_dir "$FAKE_EGPU_PCI_ADDR")
enabled=$(cat "$ROOT/sys/devices/platform/asus-nb-wmi/egpu_enable" 2>/dev/null)
appears=$(cat "$SHIM_STATE/egpu_appears" 2>/dev/null)
drops=$(cat "$SHIM_STATE/egpu_drops" 2>/dev/null)
read -r card render fb < "$SHIM_STATE/egpu_nodes" 2>/dev/null || { card=card1; render=renderD129; fb=fb1; }
if [ "$enabled" = "1" ] && [ ! -e "$PCI" ]; then
  case "$appears" in
    nvidia)
      fake_gpu_add "$FAKE_EGPU_PCI_ADDR" 0x10de 0 "$card" "$render" "$fb"
      touch "$ROOT/dev/nvidiactl" "$ROOT/dev/nvidia0" "$ROOT/dev/nvidia-modeset"
      mkdir -p "$ROOT/sys/module/nvidia" "$ROOT/sys/module/nvidia_modeset" \
        "$ROOT/sys/module/nvidia_drm/parameters" "$ROOT/sys/module/nvidia_drm/holders"
      echo Y > "$ROOT/sys/module/nvidia_drm/parameters/modeset"
      echo Y > "$ROOT/sys/module/nvidia_drm/parameters/fbdev"
      echo 50 > "$ROOT/sys/module/nvidia_drm/refcnt"
      ;;
    amd)
      fake_gpu_add "$FAKE_EGPU_PCI_ADDR" 0x1002 0 "$card" "$render" "$fb"
      ;;
  esac
elif [ "$enabled" = "1" ] && [ -e "$PCI" ] && [ ! -e "$PCI/drm" ] && [ -e "$SHIM_STATE/egpu_card_at" ] \
  && [ "$(tl_tick)" -ge "$(cat "$SHIM_STATE/egpu_card_at")" ]; then
  # An unbound eGPU (egpu_card_later) whose DRM card shows up now.
  fake_egpu_card_appear
elif [ "$enabled" = "0" ] && [ -e "$PCI" ] && [ "$drops" != "no" ]; then
  fake_gpu_remove "$FAKE_EGPU_PCI_ADDR"
  rm -f "$ROOT/dev/nvidiactl" "$ROOT/dev/nvidia0" "$ROOT/dev/nvidia-modeset"
fi
exit 0
