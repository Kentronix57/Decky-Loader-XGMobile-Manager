#!/usr/bin/env bash
# Test shim. `modinfo nvidia` (the running kernel) succeeds only when the sandbox says the NVIDIA
# driver is installed. `modinfo -k <kver> nvidia` succeeds only if $SHIM_STATE/modinfo_k/<kver>
# exists (nvidia_module_for <kver>).
printf '%s\n' "$(basename "$0") $*" >> "$SHIM_LOG"
if [ "$1" = "-k" ]; then
  if [ -e "$SHIM_STATE/modinfo_k/$2" ]; then
    echo "filename:       /lib/modules/$2/extramodules/nvidia.ko.zst"
    echo "version:        615.78.08"
    exit 0
  fi
elif [ "$(cat "$SHIM_STATE/nvidia_driver" 2>/dev/null)" = "installed" ]; then
  echo "filename:       /lib/modules/6.11.11-valve12-1-neptune-611/updates/dkms/nvidia.ko.zst"
  echo "version:        610.43.02"
  exit 0
fi
echo "modinfo: ERROR: Module nvidia not found." >&2
exit 1
