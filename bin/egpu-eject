#!/bin/bash
VENDOR=$1 # Capture 'nvidia' or 'amd' from the plugin
OS_TYPE=$2
LOG_DIR=$3
DATA_DIR=$4
ROOT="${XGM_ROOT:-}"
# shellcheck source=bin/xgm-common.sh
. "$(dirname "$(readlink -f "$0")")/xgm-common.sh" || { echo "ERROR: xgm-common.sh is missing. Reinstall XG Mobile Manager."; exit 9; }
SUPERGFX_TRIG=0
PRIMARY_USER=$(xgm_primary_user)
mkdir -p "$DATA_DIR/configs"
# Written on exit 7 so the plugin can show the cancel after the display manager restart.
CANCEL_MARKER="$DATA_DIR/last_eject_cancelled"
# A result saved by an earlier enable/eject is stale now; the plugin saves this run's on failure.
rm -f "$CANCEL_MARKER" "$DATA_DIR/last_result.json"
# The previous run's log is kept as eject_<vendor>.prev.log (replacing an older one).
[ -f "$LOG_DIR/eject_${VENDOR}.log" ] && mv -f "$LOG_DIR/eject_${VENDOR}.log" "$LOG_DIR/eject_${VENDOR}.prev.log"
exec > "$LOG_DIR/eject_${VENDOR}.log" 2>&1

echo "--- XG Mobile Eject ($VENDOR) Started at $(date) ---"
DM_SERVICE=$(xgm_dm_service)
echo "Display manager: $DM_SERVICE"

if systemctl is-active --quiet supergfxd.service; then 
  echo "Supergfxd Detected. Stopping supergfxd to avoid panic during switch..."
  systemctl stop supergfxd.service 2>/dev/null || true
  SUPERGFX_TRIG=1
fi

# Stop UI
# We must kill the session before we pull the rug out from the hardware
echo "Stopping $DM_SERVICE..."
systemctl stop "$DM_SERVICE"

ENABLE_PATH="$ROOT/sys/devices/platform/asus-nb-wmi/egpu_enable"
ACTIVE=$(cat "$ENABLE_PATH" 2>/dev/null || echo "0")

# Identify the eGPU before touching any driver: by the PCI address egpu-enable recorded, else
# the display controller(s) that aren't the boot VGA device (works for NVIDIA and AMD XG Mobiles).
# Card, render and fb numbers change between boots, so the nodes are matched to the PCI device.
# The PCI paths are what the drop wait watches, since an NVIDIA card node is gone once nvidia_drm
# is unloaded.
EGPU_PCI=()
EGPU_NODES=()
if [ "$ACTIVE" = "1" ]; then
  mapfile -t EGPU_PCI < <(xgm_egpu_pci_paths "$DATA_DIR")
  for pci in "${EGPU_PCI[@]}"; do
    mapfile -t names < <(xgm_drm_nodes "$pci")
    for node in "${names[@]}"; do
      EGPU_NODES+=("$ROOT/dev/dri/$node")
    done
    mapfile -t fbs < <(xgm_fb_nodes "$pci")
    for node in "${fbs[@]}"; do
      EGPU_NODES+=("$ROOT/dev/$node")
    done
    names+=("${fbs[@]}")
    echo "eGPU: $(basename "$pci") (${names[*]:-no DRM nodes})"
  done
fi

if [ "$VENDOR" == "nvidia" ]; then
  echo "Stopping NVIDIA power services..."
  systemctl stop nvidia-powerd nvidia-persistenced 2>/dev/null || true
  if [[ "$OS_TYPE" == *"bazzite"* ]]; then
    systemctl disable nvidia-powerd nvidia-persistenced 2>/dev/null || true
  fi
fi

# The eGPU device nodes that exist right now.
gpu_nodes() {
  local node
  for node in "${EGPU_NODES[@]}"; do
    [ -e "$node" ] && echo "$node"
  done
  if [ "$VENDOR" == "nvidia" ]; then
    for node in $ROOT/dev/nvidia*; do
      [ -e "$node" ] && echo "$node"
    done
  fi
}

gpu_in_use() {
  local nodes
  mapfile -t nodes < <(gpu_nodes)
  [ "${#nodes[@]}" -gt 0 ] && fuser -s "${nodes[@]}" 2>/dev/null
}

# wait_for_release <seconds>: 0 once nothing holds the eGPU nodes, 1 if something still does.
wait_for_release() {
  local i=0
  while gpu_in_use; do
    [ "$i" -ge "$1" ] && return 1
    sleep 1
    i=$((i + 1))
  done
  return 0
}

# Logs which processes hold the eGPU nodes, then sends them the signal (TERM or KILL).
kill_holders() {
  local nodes
  mapfile -t nodes < <(gpu_nodes)
  [ "${#nodes[@]}" -gt 0 ] || return 0
  echo "Processes still using the eGPU:"
  fuser -v "${nodes[@]}" 2>&1 || true
  echo "Sending SIG$1 to them..."
  fuser -k "-$1" "${nodes[@]}" >/dev/null 2>&1 || true
}

nvidia_drm_refcnt() { cat "$ROOT/sys/module/nvidia_drm/refcnt" 2>/dev/null || echo "not loaded"; }

# What holds the GPU outside userspace, for the log: framebuffers, consoles, module state.
gpu_diagnostics() {
  local vt fb
  echo "--- GPU diagnostics ---"
  echo "/proc/fb:"
  sed 's/^/  /' "$ROOT/proc/fb" 2>/dev/null
  for vt in $ROOT/sys/class/vtconsole/vtcon*; do
    [ -e "$vt" ] && echo "$(basename "$vt"): $(cat "$vt/name" 2>/dev/null) (bind $(cat "$vt/bind" 2>/dev/null))"
  done
  for fb in $ROOT/sys/class/graphics/fb*; do
    [ -e "$fb/device" ] && echo "$(basename "$fb") -> $(basename "$(readlink -f "$fb/device")")"
  done
  echo "nvidia_drm modeset=$(cat "$ROOT/sys/module/nvidia_drm/parameters/modeset" 2>/dev/null || echo "?") fbdev=$(cat "$ROOT/sys/module/nvidia_drm/parameters/fbdev" 2>/dev/null || echo "?")"
  echo "nvidia_drm refcnt before the release: $REFCNT_BEFORE, now: $(nvidia_drm_refcnt)"
  echo "nvidia_drm holders: $(ls "$ROOT/sys/module/nvidia_drm/holders" 2>/dev/null | xargs)"
  echo "lsmod:"
  lsmod | grep -E 'nvidia|drm' | sed 's/^/  /'
  echo "--- end of GPU diagnostics ---"
}

# NVIDIA always has /dev/nvidia* and its modules to release, even when no eGPU PCI device was
# found; AMD with nothing found has nothing to release.
RELEASE=0
if [ "${#EGPU_PCI[@]}" -gt 0 ]; then
  RELEASE=1
elif [ "$ACTIVE" = "1" ] && [ "$VENDOR" == "nvidia" ]; then
  echo "No eGPU PCI device found. Releasing the NVIDIA device nodes and modules anyway."
  RELEASE=1
elif [ "$ACTIVE" = "1" ]; then
  echo "No eGPU found. Skipping the GPU release."
else
  echo "XG Mobile is already off. Skipping the GPU release."
fi

if [ "$RELEASE" -eq 1 ]; then
  REFCNT_BEFORE=$(nvidia_drm_refcnt)
  # Release order: wait for the session to let go, ask what's left to exit, force it, then unload
  # the driver. Only the eGPU's own nodes: the iGPU's stay untouched.
  echo "Waiting for processes using the eGPU to exit..."
  if ! wait_for_release 10; then
    kill_holders TERM
    if ! wait_for_release 5; then
      kill_holders KILL
      wait_for_release 2
    fi
  fi

  if [ "$VENDOR" == "nvidia" ]; then
    echo "Unloading NVIDIA modules..."
    # nvidia_drm first; if it can't go, the modules under it can't either, so stop there.
    if modprobe -r nvidia_drm; then
      modprobe -r nvidia_modeset || true
      modprobe -r nvidia_uvm || true
      modprobe -r nvidia || true
    else
      echo "nvidia_drm couldn't be unloaded; leaving the other NVIDIA modules loaded."
    fi
  fi

  # Safety stop: powering off a GPU that a process still uses hangs the session, so cancel.
  if gpu_in_use; then
    echo "ERROR: The eGPU is still in use. Eject cancelled; the XG Mobile stays powered on."
    mapfile -t NODES < <(gpu_nodes)
    echo "Processes still using the eGPU:"
    fuser -v "${NODES[@]}" 2>&1 || true
    gpu_diagnostics
    if [ "$VENDOR" == "nvidia" ]; then
      echo "Restoring NVIDIA power services..."
      if [[ "$OS_TYPE" == *"bazzite"* ]]; then
        systemctl enable nvidia-powerd nvidia-persistenced 2>/dev/null || true
      fi
      systemctl start nvidia-persistenced nvidia-powerd 2>/dev/null || true
    fi
    if [ "$SUPERGFX_TRIG" -eq 1 ]; then
      echo "Restarting supergfxd..."
      systemctl start supergfxd.service 2>/dev/null || true
    fi
    date +%s > "$CANCEL_MARKER"
    echo "Starting $DM_SERVICE..."
    systemctl start "$DM_SERVICE"
    exit 7
  fi

  # No process uses the eGPU, but the driver can still be held in the kernel (CachyOS: the DRM
  # fbdev client). Powering off in that state is what eject always did, and it works.
  if [ "$VENDOR" == "nvidia" ] && [ -e "$ROOT/sys/module/nvidia_drm" ]; then
    echo "WARNING: NVIDIA driver still loaded (in-kernel framebuffer reference); no processes use the eGPU, powering it off as before."
    HOLDERS=$(ls "$ROOT/sys/module/nvidia_drm/holders" 2>/dev/null | xargs)
    [ -n "$HOLDERS" ] && echo "nvidia_drm is held by modules (not processes): $HOLDERS"
    gpu_diagnostics
  fi
fi

if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  if [ "$VENDOR" == "nvidia" ]; then
    # De-Fanging Configs
    # On CachyOS these files belong to pacman packages: moving them breaks package integrity, and
    # the next nvidia-utils update puts them back anyway. Leave them in place there.
    if [[ "$OS_TYPE" == *"cachyos"* ]]; then
      echo "CachyOS: NVIDIA configs are owned by pacman packages, leaving them in place."
    else
      echo "De-fanging NVIDIA configs to protect AMD Handheld Mode..."
      xgm_ro_disable
      mkdir -p $DATA_DIR/configs_backup
      mv $ROOT/usr/share/glvnd/egl_vendor.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
      mv $ROOT/usr/share/vulkan/implicit_layer.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
      mv $ROOT/usr/share/vulkan/explicit_layer.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
      mv $ROOT/usr/share/vulkan/icd.d/*nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
      mv $ROOT/usr/share/X11/xorg.conf.d/10-nvidia* $DATA_DIR/configs_backup/ 2>/dev/null || true
      xgm_ro_enable
    fi
  fi
  # Variables in /etc/environment and both systemd managers, Plasma env files, nvidia-egpu.conf.
  xgm_sanitize_environment "$PRIMARY_USER"
elif [[ "$OS_TYPE" == *"bazzite"* ]]; then
  if [ "$VENDOR" == "nvidia" ]; then
    echo "Applying Bazzite overlay environment fixes..."
    USER_UID=$(id -u $PRIMARY_USER)
    export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
  
    systemctl unset-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT
    sudo -u $PRIMARY_USER $DECK_BUS systemctl --user unset-environment GAMESCOPE_DISABLE_VK_KHR_PRESENT_WAIT

  fi
fi 

systemctl daemon-reload
# Final Reload & Restore Handheld UI
if [[ "$OS_TYPE" == "steamos" || "$OS_TYPE" == *"cachyos"* ]]; then
  USER_UID=$(id -u $PRIMARY_USER)
  export DECK_BUS="XDG_RUNTIME_DIR=/run/user/$USER_UID"
  sudo -u $PRIMARY_USER $DECK_BUS systemctl --user daemon-reload
fi

# Hardware Deactivation
echo 0 > "$ENABLE_PATH" || true
echo 1 > $ROOT/sys/bus/pci/rescan

# Wait for the eGPU's PCI device to go away (none recorded: nothing to wait for).
COUNT=0
SUCCESS=1
for pci in "${EGPU_PCI[@]}"; do
  SUCCESS=0
  while [ $COUNT -lt 15 ]; do
    if [ ! -e "$pci" ]; then
      echo "Success! eGPU $(basename "$pci") dropped from the PCIe bus. eGPU safely detached."
      SUCCESS=1
      break
    fi
    echo "Waiting for eGPU to drop from PCIe bus... ($COUNT)"
    sleep 1
    ((COUNT++))
  done
  [ "$SUCCESS" -eq 0 ] && break
done

if [ "$SUCCESS" -eq 0 ]; then
  echo "WARNING: Hardware did not seem to drop from the PCIe bus. Proceeding anyway to restore UI."
fi

echo "Starting $DM_SERVICE..."
systemctl start "$DM_SERVICE" #--no-block

#if [ $SUPERGFX_TRIG == 1 ]; then
#  echo "Restarting supergfxctl..."
#  systemctl restart supergfxd.service 2>/dev/null || true
#fi
#Bazzite leaves this off by default in the deck images so lets just let the user re-enable if they need to
#if command -v supergfxctl >/dev/null 2>&1; then #[[ "$OS_TYPE" == *"bazzite"* || "$OS_TYPE" == "cachyos" ]]; then
  #echo "Restarting ASUS daemon to restore Power Profile UI controls..."
  #systemctl start supergfxd.service 2>/dev/null || true
  
  #echo "Executing detached SDDM restart..."
  #( sleep 2 && systemctl restart sddm ) >/dev/null 2>&1 &
  #disown
#fi 
PRODUCT_NAME=$(cat $ROOT/sys/class/dmi/id/product_name 2>/dev/null || echo "Unknown")

if command -v supergfxctl >/dev/null 2>&1; then
  if [[ "$PRODUCT_NAME" == *"RC71L"* || "$PRODUCT_NAME" == *"Ally"* ]]; then
    echo "Handheld Detected ($PRODUCT_NAME). Disabling supergfxd to prevent interference..."
    systemctl disable supergfxd.service 2>/dev/null || true
  elif [[ "$PRODUCT_NAME" == *"Flow"* || "$PRODUCT_NAME" == *"GV"* || "$PRODUCT_NAME" == *"GZ"* ]]; then
    echo "Flow Laptop Detected ($PRODUCT_NAME). Re-enabling supergfxd for MUX control just in case..."
    systemctl enable supergfxd.service 2>/dev/null || true
  else
    echo "Unknown ASUS device ($PRODUCT_NAME). Leaving supergfxd alone."
  fi
fi

echo "--- Eject Finished: Back to Handheld Mode ---"
ln -sf "$LOG_DIR/eject_${VENDOR}.log" "$LOG_DIR/eject_latest.log"
