#!/bin/bash
# Boot safety net, run by xgmobile-boot-sync.service before the display manager starts. Takes no
# arguments (the optional ones, [log dir [data dir]], are for tests); the OS, user and eGPU are
# detected.
#   XG Mobile not active: undo everything egpu-enable injected, so a boot without the XG Mobile
#     (powered off while enabled, never ejected) doesn't come up on a missing GPU.
#   XG Mobile active with an NVIDIA eGPU: refresh the DRM node variables for this boot.
ROOT="${XGM_ROOT:-}"
# shellcheck source=bin/xgm-common.sh
. "$(dirname "$(readlink -f "$0")")/xgm-common.sh" || { echo "ERROR: xgm-common.sh is missing. Reinstall XG Mobile Manager."; exit 9; }
# <homebrew>/plugins/xgmobile-manager/bin -> <homebrew>/logs/xgmobile-manager/activity and
# <homebrew>/data/xgmobile-manager
HOMEBREW_DIR=$(readlink -m "$(dirname "$(readlink -f "$0")")/../../..")
LOG_DIR="${1:-$(xgm_log_dir)}"
DATA_DIR="${2:-$HOMEBREW_DIR/data/xgmobile-manager}"
if mkdir -p "$LOG_DIR" 2>/dev/null && : > "$LOG_DIR/boot_sync.log" 2>/dev/null; then
  exec > "$LOG_DIR/boot_sync.log" 2>&1
fi

echo "--- Boot DRM Sync Started at $(date) ---"
OS_TYPE=$(xgm_os_type)
echo "OS: $OS_TYPE"

if [[ "$OS_TYPE" != "steamos" && "$OS_TYPE" != *"cachyos"* ]]; then
  echo "$OS_TYPE: egpu-enable doesn't inject the eGPU environment here. Skipping."
  exit 0
fi

# Steam usually isn't running yet at boot: xgm_primary_user falls back to the first regular user.
PRIMARY_USER=$(xgm_primary_user)
echo "Primary user: $PRIMARY_USER"

ACTIVE=$(cat $ROOT/sys/devices/platform/asus-nb-wmi/egpu_enable 2>/dev/null || echo "0")
CONNECTED=$(cat $ROOT/sys/devices/platform/asus-nb-wmi/egpu_connected 2>/dev/null || echo "1")
# The eGPU: by the PCI address egpu-enable recorded (strict: a recorded device that's gone means
# the eGPU is absent), else the non-boot-VGA card. Card numbers change between boots, so the nodes
# are matched to the PCI device.
EGPU_PCI=$(xgm_egpu_pci_paths "$DATA_DIR" strict | head -n 1)

# Not active: egpu_enable off (or missing), the cable not locked, or "on" with no eGPU on the bus.
REASON=""
if [ "$ACTIVE" != "1" ]; then
  REASON="egpu_enable is ${ACTIVE:-missing}"
elif [ "$CONNECTED" = "0" ]; then
  REASON="egpu_enable is 1 but the XG Mobile isn't connected (egpu_connected=0)"
elif [ -z "$EGPU_PCI" ]; then
  REASON="egpu_enable is 1 but no eGPU PCI device was found"
fi
if [ -n "$REASON" ]; then
  echo "XG Mobile not active: $REASON."
  xgm_sanitize_environment "$PRIMARY_USER"
  echo "Boot safety net: XG Mobile not active, cleaned eGPU environment"
  exit 0
fi

# Graceful exit for AMD users
if [ "$(cat "$EGPU_PCI/vendor" 2>/dev/null)" != "0x10de" ]; then
  echo "No NVIDIA eGPU detected. Native amdgpu drivers do not require DRM environment sync."
  echo "Sync complete (Skipped cleanly)."
  exit 0
fi

# nvidia is loaded by systemd-modules-load, but nvidia-drm registers the eGPU's DRM card a few
# seconds later, asynchronously: at boot it can still be missing here. Wait for it, up to
# XGM_CARD_WAIT s (10): with `udevadm wait` on its by-path link (systemd 251+), else by polling sysfs.
CARD_WAIT="${XGM_CARD_WAIT:-10}"
egpu_card_present() { compgen -G "$EGPU_PCI/drm/card[0-9]*" > /dev/null; }
if egpu_card_present; then
  echo "eGPU DRM card already present"
else
  START=$(_xgm_now_cs)
  LAST=$START
  SLEPT=0
  if udevadm wait --help > /dev/null 2>&1; then
    udevadm wait --timeout="$CARD_WAIT" "$ROOT/dev/dri/by-path/pci-$(basename "$EGPU_PCI")-card" > /dev/null 2>&1
  else
    while ! egpu_card_present; do
      NOW=$(_xgm_now_cs)
      # At least the poll just slept has passed: if the clock shows less (NTP stepped it back),
      # move START back by the difference, so the time already waited still counts.
      [ $((LAST + SLEPT - NOW)) -gt 0 ] && START=$((START - (LAST + SLEPT - NOW)))
      LAST=$NOW
      [ $((NOW - START)) -lt "$(_xgm_cs "$CARD_WAIT")" ] || break
      sleep 0.25
      SLEPT=25
    done
  fi
  WAITED=$(_xgm_since "$START")
  egpu_card_present && echo "eGPU DRM card appeared after $(_xgm_secs "$WAITED")s"
fi

# The eGPU's card node, and the iGPU's: any other card, the boot VGA device preferred.
EGPU_CARD=""
IGPU_CARD=""
for card in $ROOT/sys/class/drm/card*; do
  [[ "$(basename $card)" =~ ^card[0-9]+$ ]] || continue
  [ -e "$card/device" ] || continue
  if [ "$(readlink -f $card/device)" = "$EGPU_PCI" ]; then
    EGPU_CARD="/dev/dri/$(basename $card)"
  elif [ -z "$IGPU_CARD" ] || [ "$(cat $card/device/boot_vga 2>/dev/null)" = "1" ]; then
    IGPU_CARD="/dev/dri/$(basename $card)"
  fi
done

if [ -z "$EGPU_CARD" ] || [ -z "$IGPU_CARD" ]; then
  echo "WARNING: the eGPU's DRM card didn't appear within ${CARD_WAIT}s (or no iGPU card); sync aborted."
  exit 1
fi

echo "Updating environment variables with fresh boot nodes: $EGPU_CARD (NVIDIA) : $IGPU_CARD (AMD)"

# 1. Update the System-Wide Environment
xgm_ro_disable 2>/dev/null || true
sed -i 's|WLR_DRM_DEVICES=.*|WLR_DRM_DEVICES='$EGPU_CARD':'$IGPU_CARD'|' $ROOT/etc/environment
xgm_ro_enable 2>/dev/null || true

# 2. Update the Isolated Plasma Environment
PLASMA_ENV_DIR="$ROOT/home/$PRIMARY_USER/.config/plasma-workspace/env"
sudo -u $PRIMARY_USER bash -c "cat > '$PLASMA_ENV_DIR/xgmobile-nvidia-kwin.sh' << EOF
#!/bin/bash
export KWIN_DRM_DEVICES=$EGPU_CARD:$IGPU_CARD
export GBM_BACKEND=nvidia-drm
export __GLX_VENDOR_LIBRARY_NAME=nvidia
EOF"
echo "SteamOS/CachyOS specific DRM environment sync complete."
echo "Sync complete. Ready for Desktop Mode."
